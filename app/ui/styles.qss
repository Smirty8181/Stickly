* {
    font-family: "Segoe UI";
    font-size: 13px;
}

QWidget {
    color: #EEEAF4;
}

QMainWindow, QWidget#appRoot {
    background: #15141B;
}

QFrame#sidebar {
    background: #1B1923;
    border-right: 1px solid #302C39;
}

QLabel#brandLogo {
    background: transparent;
}

QLabel#brandName {
    color: #FBF9FF;
    font-size: 23px;
    font-weight: 700;
    letter-spacing: 0.4px;
}

QLabel#eyebrow {
    color: #AAA3B7;
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 1.2px;
    padding: 12px 2px 2px;
}

QFrame#statsPanel {
    background: #24212D;
    border: 1px solid #35303F;
    border-radius: 10px;
}

QLabel#sidebarStat {
    color: #D4CFDE;
    padding: 3px 0;
}

QLabel#pageTitle {
    color: #FAF8FE;
    font-size: 27px;
    font-weight: 700;
}

QLabel#mutedText, QLabel#cardMeta {
    color: #B3ADBF;
    font-size: 12px;
}

QLabel#noteTitle {
    color: #302B3D;
    font-size: 15px;
    font-weight: 700;
}

QLabel#emptyTitle {
    color: #FAF8FE;
    font-size: 21px;
    font-weight: 700;
    padding-bottom: 4px;
}

QLabel#emptyIllustration {
    color: #B99CFB;
    font-size: 36px;
    font-weight: 600;
}

QPushButton {
    color: #E0DBE8;
    background: transparent;
    border: 1px solid transparent;
    border-radius: 8px;
    padding: 9px 12px;
}

QPushButton:hover {
    color: #FFFFFF;
    background: #2B2835;
    border-color: #403A4C;
}

QPushButton:pressed {
    background: #363141;
}

QPushButton:focus {
    border-color: #A68AF0;
}

QPushButton#primaryButton {
    color: #FFFFFF;
    background: #8062D3;
    border: 1px solid #9A7FE7;
    font-weight: 700;
    padding: 11px 16px;
}

QPushButton#primaryButton:hover {
    background: #9275E2;
    border-color: #B39CF3;
}

QPushButton#secondaryButton {
    color: #EEE8FF;
    background: rgba(40, 34, 55, 0.75);
    border: 1px solid rgba(70, 58, 92, 0.55);
    font-weight: 600;
}

QPushButton#viewButton {
    color: #BDB6C9;
    background: #24212D;
    border: 1px solid #3B3645;
    padding: 9px 12px;
}

QPushButton#viewButton:checked {
    color: #F8F4FF;
    background: #3A314B;
    border-color: #69568D;
}

QPushButton#navigationButton {
    color: #C2BDCB;
    text-align: left;
    padding: 11px 12px;
}

QPushButton#navigationButton:hover {
    color: #FFFFFF;
    background: #292633;
}

QPushButton#navigationButton:checked {
    color: #F8F4FF;
    background: #322B41;
    border-color: #54456E;
    font-weight: 650;
}

QFrame#noteCard {
    border: 1px solid #383341;
    border-radius: 10px;
}

QFrame#noteCard:hover {
    border-color: #8570B0;
}

QFrame#emptyState {
    background: #201E29;
    border: 1px solid #393443;
    border-radius: 14px;
}

QLineEdit#searchInput, QLineEdit {
    color: #F3F0F8;
    background: #24212D;
    border: 1px solid #3B3645;
    border-radius: 9px;
    padding: 10px 12px;
    selection-color: #FFFFFF;
    selection-background-color: #7359BC;
}

QLineEdit::placeholder {
    color: #B3ADBF;
}

QLineEdit:focus {
    border-color: #9B7DE6;
}

QComboBox {
    color: #E7E2EF;
    background: #24212D;
    border: 1px solid #3B3645;
    border-radius: 9px;
    padding: 9px 28px 9px 11px;
}

QComboBox:hover {
    border-color: #625477;
}

QComboBox::drop-down {
    border: none;
    width: 24px;
}

QComboBox QAbstractItemView {
    color: #F1EDF7;
    background: #25222F;
    border: 1px solid #494252;
    selection-color: #FFFFFF;
    selection-background-color: #574774;
}

QTabWidget#contentTabs::pane {
    border: none;
    top: -1px;
}

QTabBar::tab {
    color: #B3ADBF;
    background: transparent;
    border: none;
    border-bottom: 2px solid transparent;
    padding: 12px 18px;
    margin-right: 4px;
}

QTabBar::tab:selected {
    color: #F1EAFE;
    border-bottom: 2px solid #A98CF1;
    font-weight: 650;
}

QTabBar::tab:hover:!selected {
    color: #E1DCEA;
}

QListWidget#tasksList, QListWidget#trashList {
    color: #E6E1EC;
    background: #1D1B26;
    border: 1px solid #393443;
    border-radius: 12px;
    padding: 8px;
    outline: none;
}

QListWidget::item {
    border-bottom: 1px solid #393443;
    padding: 11px 8px;
}

QListWidget::item:selected {
    color: #FFFFFF;
    background: #373047;
    border-radius: 6px;
}

QScrollArea {
    background: transparent;
}

QScrollBar:vertical {
    background: transparent;
    width: 9px;
    margin: 2px;
}

QScrollBar::handle:vertical {
    background: #514B5D;
    border-radius: 4px;
    min-height: 30px;
}

QScrollBar::handle:vertical:hover {
    background: #756A89;
}

QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    height: 0;
}

QMenu {
    color: #F0ECF5;
    background: #292633;
    border: 1px solid #494354;
    padding: 5px;
}

QMenu::item {
    padding: 8px 24px 8px 12px;
    border-radius: 5px;
}

QMenu::item:selected {
    color: #FFFFFF;
    background: #51466A;
}

QDialog, QGroupBox {
    color: #F0ECF5;
    background: #201E29;
}

QGroupBox {
    border: 1px solid #403A49;
    border-radius: 10px;
    margin-top: 9px;
    padding: 16px 10px 10px;
    font-weight: 600;
}

QGroupBox::title {
    subcontrol-origin: margin;
    left: 12px;
    padding: 0 5px;
}

QCheckBox {
    spacing: 8px;
    padding: 4px;
}

QCheckBox::indicator {
    width: 17px;
    height: 17px;
}

QCheckBox::indicator:unchecked {
    border: 1px solid #777082;
    border-radius: 5px;
    background: #292633;
}

QCheckBox::indicator:checked {
    border: 1px solid #A98CF1;
    border-radius: 5px;
    background: #8065D2;
}

QSpinBox {
    color: #F0ECF5;
    background: #292633;
    border: 1px solid #484151;
    border-radius: 7px;
    padding: 7px;
}
